#!/bin/sh
set -e
if [ "$1" = configure ]; then
    if ! getent passwd aria-move >/dev/null; then
        adduser --system --group --home /var/lib/aria-move --no-create-home aria-move
    fi
    install -d -o aria-move -g aria-move -m 0750 /var/lib/aria-move /var/log/aria-move
    install -d -o aria-move -g aria-move -m 0750 /var/lib/aria-move/incoming /var/lib/aria-move/completed
    if [ ! -e /var/lib/aria-move/aria2.session ]; then
        install -o aria-move -g aria-move -m 0640 /dev/null /var/lib/aria-move/aria2.session
    fi
fi
#DEBHELPER#
if [ "$1" = configure ]; then
    echo 'Aria Move installed. Mover configuration: /etc/aria_move/config.xml.'
    echo 'Bundled service: systemctl status aria-move. When started, its default RPC endpoint is localhost:6800.'
    echo 'Bundled RPC token after startup: sudo cat /var/lib/aria-move/rpc-secret.'
    echo 'If using your own aria2 service, keep the bundled service disabled and manage your existing service instead.'
    echo 'Setup and troubleshooting: /usr/share/doc/aria-move/INSTALLATION.md.'
fi
